{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "platform": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "const": 1
        },
        "exposure": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ingress", "nodePort"]
            }
          }
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "className": {
              "type": "string"
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "host": {
                    "type": "string",
                    "minLength": 1
                  },
                  "paths": {
                    "type": "array"
                  }
                },
                "required": ["host", "paths"]
              }
            }
          }
        },
        "extraVolumes": {
          "type": "array"
        },
        "extraVolumeMounts": {
          "type": "array"
        },
        "config": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKeys": {
              "type": "object",
              "properties": {
                "config": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]+$"
                }
              },
              "required": ["config"]
            },
            "existingEnvSecret": {
              "type": "string"
            },
            "cluster": {
              "type": "object",
              "properties": {
                "tryDefault": {
                  "type": "boolean"
                },
                "kubeConfigPath": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "serviceAccount": {
                "properties": {
                  "create": {
                    "const": false
                  }
                },
                "required": ["create"]
              }
            }
          },
          "then": {
            "properties": {
              "serviceAccount": {
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["name"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "exposure": {
                "properties": {
                  "type": {
                    "const": "ingress"
                  }
                },
                "required": ["type"]
              }
            }
          },
          "then": {
            "properties": {
              "ingress": {
                "properties": {
                  "hosts": {
                    "minItems": 1
                  }
                },
                "required": ["hosts"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "config": {
                "properties": {
                  "cluster": {
                    "properties": {
                      "tryDefault": {
                        "const": false
                      }
                    },
                    "required": ["tryDefault"]
                  }
                },
                "required": ["cluster"]
              }
            },
            "required": ["config"]
          },
          "then": {
            "properties": {
              "config": {
                "properties": {
                  "cluster": {
                    "properties": {
                      "kubeConfigPath": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["kubeConfigPath"]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["internal", "external"]
        },
        "auth": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKeys": {
              "type": "object",
              "properties": {
                "username": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "password": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "database": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]+$"
                }
              },
              "required": ["username", "password", "database"]
            }
          }
        },
        "external": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKeys": {
              "type": "object",
              "properties": {
                "username": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "password": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "database": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]+$"
                }
              },
              "required": ["username", "password", "database"]
            },
            "host": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "external"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "external": {
                "properties": {
                  "host": {
                    "minLength": 1
                  }
                },
                "required": ["host"]
              }
            }
          }
        }
      ]
    },
    "valkey": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["internal", "external"]
        },
        "architecture": {
          "type": "string",
          "enum": ["standalone", "replication"]
        },
        "auth": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKeys": {
              "type": "object",
              "properties": {
                "password": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]+$"
                }
              },
              "required": ["password"]
            }
          }
        },
        "replica": {
          "type": "object",
          "properties": {
            "replicaCount": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "external": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKeys": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]+$"
                }
              },
              "required": ["url"]
            },
            "url": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "external"
              },
              "external": {
                "properties": {
                  "existingSecret": {
                    "maxLength": 0
                  }
                },
                "required": ["existingSecret"]
              }
            },
            "required": ["mode", "external"]
          },
          "then": {
            "properties": {
              "external": {
                "properties": {
                  "url": {
                    "minLength": 1
                  }
                },
                "required": ["url"]
              }
            }
          }
        }
      ]
    },
    "nats": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["internal", "external"]
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "auth": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKeys": {
              "type": "object",
              "properties": {
                "token": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]+$"
                }
              },
              "required": ["token"]
            }
          }
        },
        "external": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKeys": {
              "type": "object",
              "properties": {
                "token": {
                  "type": "string",
                  "pattern": "^$|^[A-Za-z0-9._-]+$"
                },
                "user": {
                  "type": "string",
                  "pattern": "^$|^[A-Za-z0-9._-]+$"
                },
                "password": {
                  "type": "string",
                  "pattern": "^$|^[A-Za-z0-9._-]+$"
                }
              },
              "required": ["token", "user", "password"]
            },
            "host": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "external"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "external": {
                "properties": {
                  "host": {
                    "minLength": 1
                  }
                },
                "required": ["host"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "external"
              },
              "external": {
                "properties": {
                  "existingSecret": {
                    "minLength": 1
                  }
                },
                "required": ["existingSecret"]
              }
            },
            "required": ["mode", "external"]
          },
          "then": {
            "properties": {
              "external": {
                "properties": {
                  "secretKeys": {
                    "anyOf": [
                      {
                        "properties": {
                          "token": {
                            "minLength": 1
                          }
                        },
                        "required": ["token"]
                      },
                      {
                        "properties": {
                          "user": {
                            "minLength": 1
                          },
                          "password": {
                            "minLength": 1
                          }
                        },
                        "required": ["user", "password"]
                      }
                    ]
                  }
                },
                "required": ["secretKeys"]
              }
            }
          }
        }
      ]
    },
    "registry": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["disabled", "internal", "external"]
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "externalAccess": {
          "type": "object",
          "properties": {
            "serviceType": {
              "type": "string",
              "enum": ["NodePort", "LoadBalancer"]
            },
            "host": {
              "type": "string"
            }
          }
        },
        "external": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKeys": {
              "type": "object",
              "properties": {
                "username": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "password": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]+$"
                }
              },
              "required": ["username", "password"]
            },
            "server": {
              "type": "string"
            },
            "external": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "internal"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "externalAccess": {
                "properties": {
                  "host": {
                    "minLength": 1
                  }
                },
                "required": ["host"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "external"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "external": {
                "properties": {
                  "server": {
                    "minLength": 1
                  },
                  "external": {
                    "minLength": 1
                  }
                },
                "required": ["server", "external"]
              }
            }
          }
        }
      ]
    },
    "victoriaLogs": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["disabled", "internal", "external"]
        },
        "external": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKeys": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]+$"
                }
              },
              "required": ["url"]
            },
            "url": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "external"
              },
              "external": {
                "properties": {
                  "existingSecret": {
                    "maxLength": 0
                  }
                },
                "required": ["existingSecret"]
              }
            },
            "required": ["mode", "external"]
          },
          "then": {
            "properties": {
              "external": {
                "properties": {
                  "url": {
                    "minLength": 1
                  }
                },
                "required": ["url"]
              }
            }
          }
        }
      ]
    }
  }
}
